# Copy to .env.local. Values come from your Supabase project's Connect dialog
# (Project Settings → Data API). Keep this template's values blank in git.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never prefix with NEXT_PUBLIC_ and never import it in client code.
SUPABASE_SECRET_KEY=
